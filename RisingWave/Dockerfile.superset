FROM apache/superset:latest

USER root

# Optional: needed only if you plan to use Alerts & Reports screenshots
ENV PLAYWRIGHT_BROWSERS_PATH=/usr/local/share/playwright-browsers

# Install OS-level dependencies (keep this minimal)
RUN apt-get update && apt-get install -y \
    postgresql-client \
    python3-dev \
    && rm -rf /var/lib/apt/lists/*

# Install Python dependencies into Superset venv using uv (official approach)
RUN . /app/.venv/bin/activate && \
    uv pip install -i https://mirror-pypi.runflare.com/simple\
        psycopg2-binary==2.9.9 \
        sqlalchemy-risingwave==1.0.0 \
        redis==5.0.1

# Create and set permissions for marker file directory
RUN mkdir -p /app/initialized_marker && \
    chown superset:superset /app/initialized_marker

# Switch back to non-root user
USER superset

# Custom config & init
COPY --chown=superset:superset superset_config.py /app/pythonpath/
COPY --chown=superset:superset superset-init.sh /app/
RUN chmod +x /app/superset-init.sh

# Default Superset entrypoint
CMD ["/app/superset-init.sh"]